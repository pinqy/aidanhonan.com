{
  "name": "aidanhonan.com",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm install && npm run format && ng build && npm run test:headless",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:headless": "ng test --watch=false",
    "lint": "ng lint",
    "format": "ng lint --fix",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "ngx-cookie-service": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "angular-eslint": "22.2.0",
    "eslint": "^9.39.2",
    "jsdom": "^29.1.1",
    "typescript": "~6.0",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
